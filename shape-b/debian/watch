# The driver this package installs is proprietary and is never redistributed
# here, so there is no upstream tarball for uscan to fetch on our behalf. What
# there IS is a place where a new driver version would appear first, and this
# file records it so the check is a command rather than somebody's memory.
#
# Broadcom publishes the driver here; Canonical packages the same version into
# the OEM pocket that install.sh prefers.
version=5
opts="mode=http,pgpmode=none" \
  https://packages.broadcom.com/artifactory/dell-controlvault-drivers/ \
  brcm_linux_fp_([\d.]+)_([\d.]+)\.tgz debian uupdate
