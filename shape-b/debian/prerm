#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -e

LIBEXEC=/usr/libexec/libfprint-2-tod1-broadcom-installer

# On removal (but not on upgrade) take the driver back out and restore whatever
# the installer backed up. uninstall.sh leaves enrolled fingerprints untouched.
case "$1" in
    remove)
        if [ -x "$LIBEXEC/uninstall.sh" ]; then
            # Deliberately NOT "|| true". A failure here means the proprietary
            # driver is still on the machine, and reporting a clean removal in
            # that state is the one outcome a user must never get: they asked
            # for the blob to go and would be told it had.
            if ! "$LIBEXEC/uninstall.sh"; then
                echo "error: could not remove the fingerprint driver files." >&2
                echo "       The driver is still installed. Run this by hand to see why:" >&2
                echo "         sudo $LIBEXEC/uninstall.sh" >&2
                echo "       then retry the removal." >&2
                exit 1
            fi
        fi
        ;;
esac

#DEBHELPER#

exit 0
